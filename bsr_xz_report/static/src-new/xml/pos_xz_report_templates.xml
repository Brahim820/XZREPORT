<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="XZReportButtons" owl="1">
        <div class="control-buttons">
            <div class="control-button" t-on-click="onClickXReport">
                <i class="fa fa-file-text-o"/>
                <span><t t-esc="xReportText"/></span>
            </div>
            <div class="control-button" t-on-click="onClickZReport">
                <i class="fa fa-file-text"/>
                <span><t t-esc="zReportText"/></span>
            </div>
        </div>
    </t>
</templates>
