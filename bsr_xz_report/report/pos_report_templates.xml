<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Report Actions -->
        <report
            id="action_report_pos_x"
            model="pos.report.x"
            string="X Report (Simple)"
            report_type="qweb-pdf"
            name="bsr_xz_report.report_pos_x_template"
            file="bsr_xz_report.report_pos_x_template"
            paperformat="bsr_xz_report.paperformat_receipt"
        />

        <report
            id="action_report_pos_z_detailed"
            model="pos.report.x"
            string="Z Report (Detailed)"
            report_type="qweb-pdf"
            name="bsr_xz_report.report_pos_z_detailed_template"
            file="bsr_xz_report.report_pos_z_detailed_template"
            paperformat="bsr_xz_report.paperformat_receipt"
        />

        <report
            id="action_report_pos_z_permanent"
            model="pos.report.z"
            string="Z Report (Backend)"
            report_type="qweb-pdf"
            name="bsr_xz_report.report_pos_z_detailed_template"
            file="bsr_xz_report.report_pos_z_detailed_template"
            paperformat="bsr_xz_report.paperformat_receipt"
        />

        <!-- X Report Template (Simple Summary) -->
        <template id="report_pos_x_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <meta charset="utf-8"/>
                    <t t-set="o" t-value="doc.with_context(lang=doc.session_id.user_id.lang)"/>
                    <div class="page" style="font-family: 'Lucida Console', Monaco, monospace; font-size: 12px; max-width: 80mm; margin: 0; padding: 10px;">
                        <div style="text-align: center;">
                            <h2 style="margin: 0;"><t t-esc="doc.name"/></h2>
                            <p style="margin: 0;"><strong>Session:</strong> <span t-field="doc.session_id.name"/></p>
                            <p style="margin: 0;"><strong>Report Date:</strong> <span t-field="doc.end_date" t-options='{"widget": "datetime"}'/></p>
                        </div>
                        <hr/>
                        <table style="width: 100%; font-size: 12px;">
                            <tr><td>Total Sales:</td><td style="text-align: right;"><span t-esc="doc.total_sales" t-options='{"widget": "monetary", "display_currency": doc.session_id.currency_id}'/></td></tr>
                            <tr><td>Total Returns:</td><td style="text-align: right;"><span t-esc="doc.total_returns" t-options='{"widget": "monetary", "display_currency": doc.session_id.currency_id}'/></td></tr>
                            <tr><td>Net Sales:</td><td style="text-align: right;"><span t-esc="doc.net_sales" t-options='{"widget": "monetary", "display_currency": doc.session_id.currency_id}'/></td></tr>
                            <tr><td>Total Taxes:</td><td style="text-align: right;"><span t-esc="doc.total_taxes" t-options='{"widget": "monetary", "display_currency": doc.session_id.currency_id}'/></td></tr>
                            <tr><td>Total Discounts:</td><td style="text-align: right;"><span t-esc="doc.total_discounts" t-options='{"widget": "monetary", "display_currency": doc.session_id.currency_id}'/></td></tr>
                            <tr style="border-top: 1px solid black;"><td style="padding-top: 5px;"><strong>Total Payments:</strong></td><td style="padding-top: 5px; text-align: right;"><strong><span t-esc="doc.total_payments" t-options='{"widget": "monetary", "display_currency": doc.session_id.currency_id}'/></strong></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </template>

        <!-- Z Report Template (Detailed) -->
        <template id="report_pos_z_detailed_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <meta charset="utf-8"/>
                    <t t-set="o" t-value="doc.with_context(lang=doc.session_id.user_id.lang)"/>
                    <div class="page" style="font-family: 'Lucida Console', Monaco, monospace; font-size: 12px; max-width: 80mm; margin: 0; padding: 10px;">
                        <!-- Header -->
                        <div style="text-align: center;">
                            <h2 style="margin: 0;"><t t-esc="doc.name"/></h2>
                            <p style="margin: 0;"><strong>Session:</strong> <span t-field="doc.session_id.name"/></p>
                            <p style="margin: 0;"><strong>Report Date:</strong> <span t-field="doc.end_date" t-options='{"widget": "datetime"}'/></p>
                        </div>

                        <!-- Financial Summary -->
                        <hr/>
                        <table style="width: 100%; font-size: 12px;">
                            <tr><td>Total Sales:</td><td style="text-align: right;"><span t-esc="doc.total_sales" t-options='{"widget": "monetary", "display_currency": doc.session_id.currency_id}'/></td></tr>
                            <tr><td>Total Returns:</td><td style="text-align: right;"><span t-esc="doc.total_returns" t-options='{"widget": "monetary", "display_currency": doc.session_id.currency_id}'/></td></tr>
                            <tr><td>Net Sales:</td><td style="text-align: right;"><span t-esc="doc.net_sales" t-options='{"widget": "monetary", "display_currency": doc.session_id.currency_id}'/></td></tr>
                            <tr><td>Total Taxes:</td><td style="text-align: right;"><span t-esc="doc.total_taxes" t-options='{"widget": "monetary", "display_currency": doc.session_id.currency_id}'/></td></tr>
                            <tr><td>Total Discounts:</td><td style="text-align: right;"><span t-esc="doc.total_discounts" t-options='{"widget": "monetary", "display_currency": doc.session_id.currency_id}'/></td></tr>
                        </table>

                        <!-- Payment Details -->
                        <hr/>
                        <h4 style="margin: 10px 0 5px 0; text-align: center;">Payment Summary</h4>
                        <table style="width: 100%; font-size: 12px;">
                            <t t-foreach="json.loads(doc.payment_details)" t-as="p">
                                <tr>
                                    <td><t t-esc="p['name']"/></td>
                                    <td style="text-align: right;"><t t-esc="p['amount']" t-options='{"widget": "monetary", "display_currency": doc.session_id.currency_id}'/></td>
                                </tr>
                            </t>
                            <tr style="border-top: 1px solid black;"><td style="padding-top: 5px;"><strong>Total Payments:</strong></td><td style="padding-top: 5px; text-align: right;"><strong><span t-esc="doc.total_payments" t-options='{"widget": "monetary", "display_currency": doc.session_id.currency_id}'/></strong></td></tr>
                        </table>

                        <!-- Category Details -->
                        <hr/>
                        <h4 style="margin: 10px 0 5px 0; text-align: center;">Category Summary</h4>
                        <table style="width: 100%; font-size: 12px;">
                             <tr style="border-bottom: 1px solid black; text-align: left;">
                                <th style="padding-bottom: 3px;">Category</th>
                                <th style="padding-bottom: 3px; text-align: center;">Qty</th>
                                <th style="padding-bottom: 3px; text-align: right;">Amount</th>
                            </tr>
                            <t t-foreach="json.loads(doc.category_details)" t-as="c">
                                <tr>
                                    <td><t t-esc="c['name']"/></td>
                                    <td style="text-align: center;"><t t-esc="c['qty']"/></td>
                                    <td style="text-align: right;"><t t-esc="c['amount']" t-options='{"widget": "monetary", "display_currency": doc.session_id.currency_id}'/></td>
                                </tr>
                            </t>
                        </table>

                        <!-- Item Count -->
                         <hr/>
                         <p style="text-align: center;"><strong>Total Items Sold:</strong> <t t-esc="doc.total_items"/></p>

                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>
