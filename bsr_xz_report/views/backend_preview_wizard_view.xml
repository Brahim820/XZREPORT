<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="bsr_pos_backend_report_preview_view_form" model="ir.ui.view">
            <field name="name">bsr.pos.backend.report.preview.form</field>
            <field name="model">bsr.pos.backend.report.preview</field>
            <field name="arch" type="xml">
                <form string="Report Preview">
                    <sheet>
                        <group>
                            <field name="report_title" nolabel="1" class="oe_title"/>
                        </group>
                        <group>
                            <group>
                                <field name="session_id"/>
                                <field name="report_date"/>
                                <field name="is_z_report" invisible="1"/>
                            </group>
                        </group>
                        <hr/>
                        <group>
                             <group string="Financial Summary">
                                <field name="total_sales"/>
                                <field name="total_returns"/>
                                <field name="net_sales"/>
                                <field name="total_taxes"/>
                                <field name="total_discounts"/>
                             </group>
                             <group string="Detailed Summary">
                                <field name="total_items"/>
                             </group>
                        </group>

                        <div attrs="{'invisible': [('is_z_report', '=', False)]}">
                            <h3>Payment Summary</h3>
                            <field name="payment_lines">
                                <tree>
                                    <field name="name"/>
                                    <field name="amount" sum="Total"/>
                                </tree>
                            </field>
                            <h3>Category Summary</h3>
                            <field name="category_lines">
                                <tree>
                                    <field name="name"/>
                                    <field name="quantity" sum="Total Qty"/>
                                    <field name="amount" sum="Total Amount"/>
                                </tree>
                            </field>
                        </div>

                    </sheet>
                    <footer>
                        <button name="action_print_report" string="Print PDF" type="object" class="btn-primary"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
