<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="pos_session_view_form_inherit_bsr_xz_report" model="ir.ui.view">
            <field name="name">pos.session.form.inherit.bsr.xz.report</field>
            <field name="model">pos.session</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="button_generate_x_report" type="object"
                            string="Preview X Report"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'opened')]}"/>
                    <button name="print_z_report_backend" type="object"
                            string="Print Z Report"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'closed')]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
